{
    "compilerOptions": {
      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "types": ["node"],
      "strict": true,
      "skipLibCheck": true,
      "esModuleInterop": true,
      "outDir": "dist",
      "rootDir": "src",
      "declaration": true
    },
    "include": ["src/**/*"]
  }  